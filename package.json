{
  "name": "bpsc-stet-platform",
  "version": "1.0.0",
  "description": "Bihar STET Computer Science Learning Platform",
  "main": "api/index.js",
  "scripts": {
    "install-all": "npm install && cd client && npm install",
    "seed": "node server/data/seed.js",
    "server": "node --watch server/server.js",
    "client": "cd client && npm run dev",
    "dev": "npx concurrently -n server,client -c cyan,yellow \"npm run server\" \"npm run client\"",
    "start": "node server/server.js",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.2",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "morgan": "^1.10.0",
    "node-cron": "^4.6.0",
    "node-telegram-bot-api": "^0.66.0",
    "nodemailer": "^9.0.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0"
  }
}
