# ---- Existing required vars ----
MONGO_URI=
CLIENT_URL=http://localhost:5173
JWT_SECRET=
JWT_EXPIRE=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- New (optional): SEO ----
# Absolute public URL of the site — used to build /sitemap.xml and /robots.txt.
# Falls back to CLIENT_URL when unset.
SITE_URL=https://yourdomain.com

# ---- Email notifications ----
# Recommended for Render (Free Tier blocks SMTP ports 25/465/587 — use Brevo HTTP API instead):
BREVO_API_KEY=your-brevo-api-v3-key
MAIL_FROM="Bihar STET CS <you@example.com>"

# Alternative SMTP backend (local dev / paid tiers with outbound SMTP allowed):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password

# When no email backend is set, emails are skipped (log-only) and everything still works.


# Daily streak-reminder cron (default 18:00 IST). Set ENABLE_EMAIL_CRON=false to disable.
STREAK_CRON=30 12 * * *
ENABLE_EMAIL_CRON=true

# ---- New (optional): Admin access ----
# Comma-separated emails that get the 'admin' role automatically on first Google sign-in.
ADMIN_EMAILS=admin@example.com
